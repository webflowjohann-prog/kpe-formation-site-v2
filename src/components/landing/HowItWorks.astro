---
const STEPS = [
  {
    n: '01',
    title: 'Connectez vos appareils',
    text: 'Synchronisez vos wearables via Terra API (500+ devices). Importez vos bilans de santé en photographiant vos résultats de laboratoire.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M12 2a9 9 0 0 1 9 9"/><path d="M12 6a5 5 0 0 1 5 5"/><circle cx="12" cy="12" r="2"/><path d="M2 12a9 9 0 0 0 9 9"/><path d="M2 12c0-2.8 1.3-5.3 3.3-7"/></svg>`,
  },
  {
    n: '02',
    title: 'Répondez au questionnaire',
    text: '65 questions calibrées pour comprendre votre mode de vie, objectifs, antécédents et contraintes. Vos agents se personnalisent immédiatement.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>`,
  },
  {
    n: '03',
    title: 'Recevez vos prescriptions',
    text: 'Chaque matin, ORACLE génère un Daily Brief avec les prescriptions de vos 6 agents, adapté à votre récupération et vos métriques du jour.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/></svg>`,
  },
  {
    n: '04',
    title: 'Progressez en continu',
    text: 'Vos agents s\'adaptent à chaque nouveau biomarqueur, sync wearable et retour de questionnaire mensuel. La performance s\'affine dans le temps.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 17l4-8 4 5 3-3 4 6"/><path d="M21 7l-3 1.5M19 3l-1 4"/></svg>`,
  },
]
---

<section id="methode" class="py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <!-- En-tête -->
    <div class="text-center mb-20">
      <span class="label text-gold block mb-4">Méthode</span>
      <h2 class="font-serif text-4xl sm:text-5xl text-t1 italic mb-5">
        Comment ça fonctionne
      </h2>
      <p class="font-sans text-t3 text-base max-w-md mx-auto leading-relaxed">
        De la connexion de vos appareils à l'optimisation continue —
        en moins de 15 minutes.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {STEPS.map((step) => (
        <div class="flex gap-5">
          <!-- Numéro + ligne verticale -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 flex-shrink-0 rounded-full bg-gold/8 border border-gold/25 flex items-center justify-center">
              <span class="font-serif text-gold text-sm font-normal italic">{step.n}</span>
            </div>
          </div>

          <!-- Contenu -->
          <div class="pb-8">
            <div class="w-10 h-10 flex items-center justify-center text-gold mb-4" set:html={step.icon} />
            <h3 class="font-sans font-medium text-t1 text-base mb-3">{step.title}</h3>
            <p class="font-sans text-sm text-t3 leading-relaxed">{step.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Data sources -->
    <div class="mt-20 glass p-8 text-center">
      <span class="label text-gold block mb-4">Sources de données certifiées</span>
      <div class="flex flex-wrap justify-center gap-4 mt-2">
        {[
          'Terra API (500+ wearables)',
          'CIQUAL ANSES',
          'BDPM ANSM / HAS',
          'Thésaurus ANSM',
          'ANSES ANC',
          'PubMed',
        ].map((source) => (
          <span class="font-sans text-[10px] text-t3 px-3 py-1.5 border border-white/[0.06] rounded-full uppercase tracking-[0.1em]">
            {source}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
