---
import BaseLayout from './BaseLayout.astro'
import TabBar from '../components/ui/TabBar'

interface Props {
  title?: string
  agent?: string
  fullHeight?: boolean
}

const { title, agent, fullHeight = false } = Astro.props
const user = Astro.locals.user
const currentPath = Astro.url.pathname
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <!-- Header app mobile -->
  <header class="sticky top-0 z-30 h-14 flex items-center justify-between px-5 bg-bg/80 backdrop-blur-[16px] border-b border-white/[0.04]">
    <a href="/app" class="flex items-center gap-2">
      <img src="/images/logo-nav.png" alt="NATICS Lab" class="h-6 w-auto" />
    </a>
    <div class="flex items-center gap-3">
      <a
        href="/app/scanner"
        class="w-9 h-9 flex items-center justify-center rounded-full border border-white/10 text-t3 hover:text-gold hover:border-gold/30 transition-all"
        aria-label="Scanner OCR"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="1" y="1" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.3"/>
          <rect x="11" y="1" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.3"/>
          <rect x="1" y="11" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.3"/>
          <path d="M11 11h1m2 0h1M11 13h1M13 11v1m0 2v1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M7 1v4M9 1v2M7 11v4M1 7h4M11 7h4M1 9h2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5"/>
        </svg>
      </a>
      <a
        href="/app/profile"
        class="w-9 h-9 flex items-center justify-center rounded-full border border-white/10 text-t3 hover:text-gold hover:border-gold/30 transition-all overflow-hidden"
        aria-label="Profil"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M2 13.5C2 11 4.5 9 8 9s6 2 6 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </header>

  <!-- Contenu principal -->
  <main class:list={['pb-24', fullHeight && 'flex-1']}>
    <slot />
  </main>

  <!-- Barre de navigation bas -->
  <TabBar client:load currentPath={currentPath} />
</BaseLayout>
