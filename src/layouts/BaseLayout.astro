---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = "Plateforme SaaS d'intelligence santé de précision",
  ogImage = '/images/og-default.webp',
} = Astro.props

const pageTitle = title ? `${title} — NATICS Lab` : 'NATICS Lab'
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://naticslab.com'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{pageTitle}</title>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon -->
    <link rel="icon" href="/images/logo/logo-natics-plein.png" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/logo/logo-natics-plein.png" />

    <!-- Slot head additionnel (meta spécifiques par page) -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Service Worker -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {})
      }
    </script>
  </body>
</html>
