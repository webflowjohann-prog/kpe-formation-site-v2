---
import AppLayout from '../../../layouts/AppLayout.astro'
import { AgentHeader } from '../../../components/ui/AgentHeader'
import type { AgentId } from '../../../components/ui/AgentHeader'
import AgentChat from '../../../components/agents/AgentChat'
import FuelDashboard from '../../../components/agents/fuel/FuelDashboard'
import MorpheeDashboard from '../../../components/agents/morphee/MorpheeDashboard'
import ForgeDashboard from '../../../components/agents/forge/ForgeDashboard'
import ZenithDashboard from '../../../components/agents/zenith/ZenithDashboard'
import AtlasDashboard from '../../../components/agents/atlas/AtlasDashboard'
import OracleDashboard from '../../../components/agents/oracle/OracleDashboard'
import { createServerSupabase } from '@/lib/supabase'

const VALID_AGENTS: AgentId[] = ['forge', 'morphee', 'fuel', 'zenith', 'atlas', 'oracle']
const { agent } = Astro.params

if (!agent || !VALID_AGENTS.includes(agent as AgentId)) {
  return Astro.redirect('/app/agents')
}

const agentId = agent as AgentId
const user = Astro.locals.user!
const supabase = createServerSupabase(Astro.cookies)

type Prescription = {id: string; title: string; description: string | null; timing: string | null; duration: string | null; priority: string}

// Données FUEL
let fuelSupplements: Prescription[] = []

// Données MORPHÉE
let sleepData = { sleep_hours: null, sleep_quality: null, morning_freshness: null, bedtime: null, wake_time: null, sleep_issues: null }
let morpheePrescriptions: Prescription[] = []

// Données FORGE
let trainingData = { training_frequency: null, training_types: null, training_goals: null, resting_hr: null, injuries: null }
let forgePrescriptions: Prescription[] = []

// Données ZÉNITH
let mentalData = { stress_level: null, meditation_practice: null, mood_stability: null, anxiety_level: null, focus_score: null }
let zenithPrescriptions: Prescription[] = []

// Données ORACLE
let oracleBiomarkers: Array<{
  id: string; biomarker_id: string | null; value: number; unit: string | null; measured_at: string
  name: string; category: string; normal_min: number | null; normal_max: number | null
  optimal_min: number | null; optimal_max: number | null
}> = []
let oracleScoreHistory: Array<{
  calculated_at: string; score: number; sleep_score: number | null; recovery_score: number | null
  activity_score: number | null; biomarker_score: number | null; compliance_score: number | null
}> = []
let oracleDailyBrief: { id: string; content: string; created_at: string } | null = null
let oracleCurrentScore = 0

// Données ATLAS
let atlasExperiences: Array<{
  id: string; title: string; short_desc: string | null; location: string; country: string
  category: string; date_start: string | null; date_end: string | null; duration_days: number | null
  capacity: number; spots_remaining: number; price_cents: number; min_oracle_score: number
  status: string; biomarker_requirements: unknown[]; prep_weeks: number | null
}> = []
let atlasBookings: Array<{id: string; experience_id: string; status: string; booked_at: string; amount_cents: number | null}> = []
let atlasMemberScore = 0

if (agentId === 'fuel') {
  const { data } = await supabase
    .from('agent_prescriptions')
    .select('id, title, description, timing, duration, priority')
    .eq('member_id', user.id)
    .eq('agent', 'fuel')
    .eq('status', 'active')
    .order('created_at', { ascending: false })
  fuelSupplements = data ?? []
}

if (agentId === 'morphee') {
  const [memberRes, presRes] = await Promise.all([
    supabase
      .from('members')
      .select('sleep_hours, sleep_quality, morning_freshness, bedtime, wake_time, sleep_issues')
      .eq('id', user.id)
      .single(),
    supabase
      .from('agent_prescriptions')
      .select('id, title, description, timing, duration, priority')
      .eq('member_id', user.id)
      .eq('agent', 'morphee')
      .eq('status', 'active')
      .order('created_at', { ascending: false }),
  ])
  if (memberRes.data) sleepData = memberRes.data as typeof sleepData
  morpheePrescriptions = presRes.data ?? []
}

if (agentId === 'forge') {
  const [memberRes, presRes] = await Promise.all([
    supabase
      .from('members')
      .select('training_frequency, training_types, training_goals, resting_hr, injuries')
      .eq('id', user.id)
      .single(),
    supabase
      .from('agent_prescriptions')
      .select('id, title, description, timing, duration, priority')
      .eq('member_id', user.id)
      .eq('agent', 'forge')
      .eq('status', 'active')
      .order('created_at', { ascending: false }),
  ])
  if (memberRes.data) trainingData = memberRes.data as typeof trainingData
  forgePrescriptions = presRes.data ?? []
}

if (agentId === 'oracle') {
  const [bioRes, scoreRes, briefRes, memberRes] = await Promise.all([
    // Biomarqueurs récents avec knowledge base
    supabase.rpc('get_member_biomarkers', { p_member_id: user.id }).then(async (rpc) => {
      // Fallback : join manuel si rpc indisponible
      if (rpc.error) {
        const [resultsRes, knowledgeRes] = await Promise.all([
          supabase
            .from('biomarker_results')
            .select('id, biomarker_id, value, unit, measured_at')
            .eq('member_id', user.id)
            .order('measured_at', { ascending: false })
            .limit(50),
          supabase
            .from('biomarker_knowledge')
            .select('id, name, category, normal_min, normal_max, optimal_min, optimal_max'),
        ])
        const kbMap = new Map((knowledgeRes.data ?? []).map((k: {id: string; name: string; category: string; normal_min: number | null; normal_max: number | null; optimal_min: number | null; optimal_max: number | null}) => [k.id, k]))
        return (resultsRes.data ?? []).map((r: {id: string; biomarker_id: string | null; value: number; unit: string | null; measured_at: string}) => {
          const kb = r.biomarker_id ? kbMap.get(r.biomarker_id) : null
          return { ...r, name: kb?.name ?? 'Inconnu', category: kb?.category ?? 'other', normal_min: kb?.normal_min ?? null, normal_max: kb?.normal_max ?? null, optimal_min: kb?.optimal_min ?? null, optimal_max: kb?.optimal_max ?? null }
        })
      }
      return rpc.data ?? []
    }),
    // Historique scores 30 derniers jours
    supabase
      .from('cortex_scores')
      .select('calculated_at, score, sleep_score, recovery_score, activity_score, biomarker_score, compliance_score')
      .eq('member_id', user.id)
      .order('calculated_at', { ascending: true })
      .limit(30),
    // Daily brief du jour
    supabase
      .from('daily_briefs')
      .select('id, content, created_at')
      .eq('member_id', user.id)
      .order('created_at', { ascending: false })
      .limit(1)
      .maybeSingle(),
    // Score courant
    supabase
      .from('members')
      .select('cortex_score')
      .eq('id', user.id)
      .single(),
  ])
  oracleBiomarkers = Array.isArray(bioRes) ? bioRes : []
  oracleScoreHistory = scoreRes.data ?? []
  oracleDailyBrief = briefRes.data ?? null
  oracleCurrentScore = memberRes.data?.cortex_score ?? 0
}

if (agentId === 'atlas') {
  const [expRes, bookRes, memberRes] = await Promise.all([
    supabase
      .from('experiences')
      .select('id, title, short_desc, location, country, category, date_start, date_end, duration_days, capacity, spots_remaining, price_cents, min_oracle_score, status, biomarker_requirements, prep_weeks')
      .in('status', ['open', 'upcoming', 'full'])
      .order('date_start', { ascending: true }),
    supabase
      .from('experience_bookings')
      .select('id, experience_id, status, booked_at, amount_cents')
      .eq('member_id', user.id)
      .neq('status', 'refunded'),
    supabase
      .from('members')
      .select('cortex_score')
      .eq('id', user.id)
      .single(),
  ])
  atlasExperiences = expRes.data ?? []
  atlasBookings = bookRes.data ?? []
  atlasMemberScore = memberRes.data?.cortex_score ?? 0
}

if (agentId === 'zenith') {
  const [memberRes, presRes] = await Promise.all([
    supabase
      .from('members')
      .select('stress_level, meditation_practice, mood_stability, anxiety_level, focus_score')
      .eq('id', user.id)
      .single(),
    supabase
      .from('agent_prescriptions')
      .select('id, title, description, timing, duration, priority')
      .eq('member_id', user.id)
      .eq('agent', 'zenith')
      .eq('status', 'active')
      .order('created_at', { ascending: false }),
  ])
  if (memberRes.data) mentalData = memberRes.data as typeof mentalData
  zenithPrescriptions = presRes.data ?? []
}
---

<AppLayout title={agentId.toUpperCase()} agent={agentId}>
  <AgentHeader agent={agentId} client:load />

  {agentId === 'fuel' && (
    <FuelDashboard memberId={user.id} supplements={fuelSupplements} client:load />
  )}
  {agentId === 'morphee' && (
    <MorpheeDashboard memberId={user.id} sleepData={sleepData} prescriptions={morpheePrescriptions} client:load />
  )}
  {agentId === 'forge' && (
    <ForgeDashboard memberId={user.id} trainingData={trainingData} prescriptions={forgePrescriptions} client:load />
  )}
  {agentId === 'zenith' && (
    <ZenithDashboard memberId={user.id} mentalData={mentalData} prescriptions={zenithPrescriptions} client:load />
  )}
  {agentId === 'atlas' && (
    <AtlasDashboard memberId={user.id} cortexScore={atlasMemberScore} experiences={atlasExperiences} bookings={atlasBookings} client:load />
  )}
  {agentId === 'oracle' && (
    <OracleDashboard memberId={user.id} biomarkers={oracleBiomarkers} scoreHistory={oracleScoreHistory} dailyBrief={oracleDailyBrief} currentScore={oracleCurrentScore} client:load />
  )}
  {agentId !== 'fuel' && agentId !== 'morphee' && agentId !== 'forge' && agentId !== 'zenith' && agentId !== 'atlas' && agentId !== 'oracle' && (
    <AgentChat agent={agentId} memberId={user.id} client:load />
  )}
</AppLayout>
