---
import AppLayout from '../../../layouts/AppLayout.astro'
import Cart from '../../../components/marketplace/Cart'
---

<AppLayout title="Panier — NATICS Lab">
  <div class="px-5 pt-6 pb-4">
    <a href="/app/marketplace" class="inline-flex items-center gap-2 font-sans text-xs text-t4 hover:text-t2 transition-colors mb-4">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Boutique
    </a>
    <span class="label text-gold block mb-1">Votre commande</span>
    <h1 class="font-serif text-2xl text-t1 italic">Panier</h1>
  </div>

  <Cart client:load />
</AppLayout>
