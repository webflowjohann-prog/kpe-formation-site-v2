---
import AppLayout from '../../../layouts/AppLayout.astro'
import ProductGrid from '../../../components/marketplace/ProductGrid'
import { createServerSupabase } from '@/lib/supabase'

const supabase = createServerSupabase(Astro.cookies)

const { data: products } = await supabase
  .from('products')
  .select('id, name, description, price_cents, category, agent_tags, dosage, image_url, featured, partners(name)')
  .eq('active', true)
  .order('featured', { ascending: false })
  .order('created_at', { ascending: true })

const checkoutStatus = Astro.url.searchParams.get('checkout')
---

<AppLayout title="Boutique — NATICS Lab">
  <div class="px-5 pt-6 pb-4">
    <span class="label text-gold block mb-1">Boutique FUEL</span>
    <h1 class="font-serif text-2xl text-t1 italic">Suppléments & Nutrition</h1>
  </div>

  {checkoutStatus === 'success' && (
    <div class="mx-5 mb-4 glass p-4 border-gold/30 bg-gold/05 flex items-center gap-3">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-gold shrink-0">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/>
        <path d="M5 8l2.5 2.5L11 5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <p class="font-sans text-xs text-t2">Commande confirmée. Vous recevrez un email de confirmation.</p>
    </div>
  )}

  <ProductGrid products={products ?? []} client:load />
</AppLayout>
