---
import AppLayout from '../../../layouts/AppLayout.astro'

const user = Astro.locals.user
---

<AppLayout title="Profil">
  <div class="px-5 py-6">
    <div class="mb-6">
      <span class="label text-gold block mb-1">Mon compte</span>
      <h1 class="font-serif text-2xl text-t1 italic">Profil</h1>
    </div>

    <!-- Info compte -->
    <div class="glass p-5 mb-4">
      <span class="label block mb-3">Compte</span>
      <p class="font-sans text-sm text-t2">{user?.email}</p>
      <p class="font-sans text-xs text-t4 mt-1">
        Membre depuis {user?.created_at ? new Date(user.created_at).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }) : '—'}
      </p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-3">
      <a href="/app/profile/devices" class="glass p-4 flex items-center justify-between hover:border-gold/20 transition-all">
        <span class="font-sans text-sm text-t2">Appareils connectés</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-t4">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/app/profile/health" class="glass p-4 flex items-center justify-between hover:border-gold/20 transition-all">
        <span class="font-sans text-sm text-t2">Questionnaire santé</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-t4">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Déconnexion -->
      <form action="/api/auth/signout" method="POST">
        <button
          type="submit"
          class="w-full glass p-4 flex items-center justify-center gap-2 text-red-400/70 hover:text-red-400 hover:border-red-500/20 transition-all"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M9 2h3a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H9M5.5 4.5L3 7l2.5 2.5M3 7h7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-sans text-sm">Se déconnecter</span>
        </button>
      </form>
    </div>
  </div>
</AppLayout>
