---
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = {
  "France métropolitaine": [
    { slug: "paris", nom: "Paris" }, { slug: "lyon", nom: "Lyon" }, { slug: "marseille", nom: "Marseille" },
    { slug: "toulouse", nom: "Toulouse" }, { slug: "bordeaux", nom: "Bordeaux" }, { slug: "nantes", nom: "Nantes" },
    { slug: "lille", nom: "Lille" }, { slug: "strasbourg", nom: "Strasbourg" }, { slug: "montpellier", nom: "Montpellier" },
    { slug: "rennes", nom: "Rennes" }, { slug: "nice", nom: "Nice" }, { slug: "grenoble", nom: "Grenoble" },
    { slug: "clermont-ferrand", nom: "Clermont-Ferrand" }, { slug: "dijon", nom: "Dijon" }, { slug: "limoges", nom: "Limoges" },
    { slug: "tours", nom: "Tours" }, { slug: "nancy", nom: "Nancy" }, { slug: "rouen", nom: "Rouen" }
  ],
  "Belgique, Suisse & Luxembourg": [
    { slug: "bruxelles", nom: "Bruxelles" }, { slug: "liege", nom: "Liège" },
    { slug: "geneve", nom: "Genève" }, { slug: "lausanne", nom: "Lausanne" }, { slug: "luxembourg", nom: "Luxembourg" }
  ],
  "Canada": [
    { slug: "montreal", nom: "Montréal" }, { slug: "quebec", nom: "Québec" }
  ],
  "Outre-mer & Pacifique": [
    { slug: "la-reunion", nom: "La Réunion" }, { slug: "martinique", nom: "Martinique" },
    { slug: "guadeloupe", nom: "Guadeloupe" }, { slug: "tahiti", nom: "Tahiti" }, { slug: "nouvelle-caledonie", nom: "Nouvelle-Calédonie" }
  ]
};
---

<BaseLayout
  title="Formation kinésiologie à distance — France & francophonie | KPE"
  description="La formation KPE en kinésiologie est accessible à distance depuis toute la France, la Belgique, la Suisse, le Canada et l'outre-mer. 8 modules, 20h+ de vidéo, certificat de praticien."
  breadcrumbs={[{name: "Formation à distance", url: "/formation-kinesiologie-a-distance"}]}
>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-badge">Partout en francophonie</div>
    <h1>La formation KPE, accessible <em style="color:var(--teal-700);font-style:italic;">où que vous soyez</em></h1>
    <p class="page-hero-sub">Pas d'école près de chez vous ? Aucune importance. La formation en Kinésiologie Psycho-Énergétique de Joël Prieur a été conçue pour l'apprentissage à distance — et plus de 2 500 étudiants l'ont suivie depuis toute la francophonie.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-label">Choisissez votre région</div>
    <h2 class="section-title">La formation près de chez vous</h2>
    {Object.entries(destinations).map(([groupe, villes]) => (
      <div style="margin-bottom:36px;">
        <h3 style="font-size:18px;color:var(--gray-900);margin-bottom:16px;">{groupe}</h3>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          {villes.map(ville => (
            <a href={`/formation-kinesiologie/${ville.slug}`} style="display:inline-block;padding:10px 18px;background:white;border:1px solid var(--gray-200);border-radius:10px;color:var(--teal-700);text-decoration:none;font-size:14px;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,0.04);">{ville.nom}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section" style="background:var(--gray-50);">
  <div class="container" style="text-align:center;">
    <h2 style="font-family:var(--font-display);font-size:clamp(24px,3vw,38px);color:var(--gray-900);margin-bottom:16px;">Un seul cursus, un seul certificat</h2>
    <p style="color:var(--gray-500);max-width:650px;margin:0 auto 30px;font-size:16px;line-height:1.7;">Quel que soit l'endroit d'où vous suivez la formation, vous accédez au même contenu intégral, au même accompagnement direct par Joël Prieur, et au même certificat de praticien KPE.</p>
    <a href="/formation-en-ligne" class="btn-primary">Découvrir la formation →</a>
  </div>
</section>

</BaseLayout>
